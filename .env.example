# ---------------------------------------------------------------------------
# Desenvolvimento local (com `docker compose up -d`)
# ---------------------------------------------------------------------------
# Não há pooler no ambiente local, então as duas apontam para a mesma conexão.
DATABASE_URL="postgresql://joelho:joelho@localhost:5434/joelho?schema=public"
DATABASE_URL_UNPOOLED="postgresql://joelho:joelho@localhost:5434/joelho?schema=public"

# ---------------------------------------------------------------------------
# Produção (Vercel)
# ---------------------------------------------------------------------------
# Estas duas variáveis são preenchidas AUTOMATICAMENTE ao conectar um banco
# Postgres (Neon) ao projeto na Vercel — não precisa criar nada à mão:
#
#   DATABASE_URL           conexão pooled, usada pelo app em runtime
#   DATABASE_URL_UNPOOLED  conexão direta, usada pelo `prisma migrate deploy`
#
# Se a sua integração expuser os nomes antigos (POSTGRES_PRISMA_URL e
# POSTGRES_URL_NON_POOLING), crie as duas acima manualmente apontando para os
# mesmos valores, nessa ordem.

# URL pública do app — usada em metadata/manifest. Opcional; sem ela o app
# funciona igual, só os metadados de compartilhamento ficam com URL relativa.
# NEXT_PUBLIC_SITE_URL="https://seu-app.vercel.app"
