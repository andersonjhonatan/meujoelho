# ---------------------------------------------------------------------------
# Desenvolvimento local (com `docker compose up -d`)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://joelho:joelho@localhost:5434/joelho?schema=public"

# ---------------------------------------------------------------------------
# Produção (Vercel)
# ---------------------------------------------------------------------------
# Em Storage > Postgres (Neon), conectar o banco ao projeto preenche estas
# variáveis automaticamente. Use a POOLED (com -pooler no host) em DATABASE_URL:
# funções serverless abrem muitas conexões curtas e estouram o limite do
# Postgres sem o pooler.
# DATABASE_URL="postgres://user:pass@host-pooler.região.aws.neon.tech/db?sslmode=require"

# URL pública do app — usada em metadata/manifest. Opcional em dev.
# NEXT_PUBLIC_SITE_URL="https://seu-app.vercel.app"
