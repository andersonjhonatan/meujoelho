# ---------------------------------------------------------------------------
# Desenvolvimento local (com `docker compose up -d`)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://joelho:joelho@localhost:5434/joelho?schema=public"

# ---------------------------------------------------------------------------
# Produção (Vercel)
# ---------------------------------------------------------------------------
# DATABASE_URL é a ÚNICA variável obrigatória, e a integração Postgres da Vercel
# a preenche sozinha ao conectar um banco ao projeto.
#
# Migration precisa de conexão direta (sem pooler), mas você não precisa
# configurar isso: scripts/migrate-deploy.js descobre a conexão direta sozinho,
# aceitando DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING ou DIRECT_DATABASE_URL
# quando existirem, e derivando do host quando não existirem.

# URL pública do app — usada em metadata/manifest. Opcional; sem ela o app
# funciona igual, só os metadados de compartilhamento ficam com URL relativa.
# NEXT_PUBLIC_SITE_URL="https://seu-app.vercel.app"
