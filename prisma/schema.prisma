generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// USUÁRIO
// ---------------------------------------------------------------------------
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  birthYear Int?
  createdAt DateTime @default(now())

  clinicalProfile ClinicalProfile?
  workoutLogs     WorkoutLog[]
  shoppingItems   ShoppingItem[]
  medications     Medication[]
}

// ---------------------------------------------------------------------------
// PERFIL CLÍNICO (dados do laudo e tratamento — vindos do guia original)
// ---------------------------------------------------------------------------
model ClinicalProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  diagnosis         String   @default("Condropatia patelofemoral grave — joelho esquerdo")
  mriFindings       String[] // achados do laudo de ressonância
  contraindications String[] // agachamento profundo, saltos, etc.
  /// Perguntas que o laudo levanta e que só o fisioterapeuta pode responder.
  /// Ficam visíveis no app para irem junto na próxima consulta.
  openQuestions     String[]
  updatedAt         DateTime @updatedAt
}

/// Medicação/suplementação em uso. Era um array de texto solto no perfil, o que
/// não deixava espaço para a informação que mais importa: para que serve, como
/// tomar e qual o limite de uso de cada um.
model Medication {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  activeName  String   // princípio ativo / composição
  kind        String   // "Medicamento" | "Suplemento" | "Uso tópico"
  purpose     String   @db.Text
  dosage      String
  cautionNote String?  @db.Text
  order       Int      @default(0)

  @@unique([userId, name])
}

// ---------------------------------------------------------------------------
// EXERCÍCIOS
// ---------------------------------------------------------------------------
enum ExerciseCategory {
  ISOMETRIA
  CADEIA_FECHADA
  CADEIA_POSTERIOR
  QUADRIL
  CORE
  PANTURRILHA
  MOBILIDADE
  CONTROLE_MOTOR
}

/// Bloco dentro da sessão — uma sessão de reabilitação tem estrutura
/// (mobiliza, ativa, treina, estabiliza, solta), não é uma lista solta.
enum SessionBlock {
  MOBILIDADE
  ATIVACAO
  PRINCIPAL
  CORE
  FINALIZACAO
}

/// Compressão patelofemoral estimada do exercício. É o filtro de segurança que
/// importa neste caso: a lesão está confinada à articulação patelofemoral
/// (patela + tróclea), com menisco, cruzados e colaterais íntegros.
enum PfjLoad {
  BAIXA
  MODERADA
  ALTA
}

model Exercise {
  id             String           @id @default(cuid())
  slug           String           @unique
  order          Int
  name           String
  category       ExerciseCategory
  // Nulo é um estado legítimo: nem todo exercício tem ilustração própria, e
  // inventar uma imagem genérica ensina o movimento errado. A tela desenha um
  // símbolo da categoria quando não há foto confiável.
  imageUrl       String?
  sets           String
  reps           String
  targetMuscles  String
  maxFlexionDeg  Int?             // amplitude máxima segura (null = sem restrição de flexão)
  isIsometric    Boolean          @default(false)
  holdSeconds    Int?             // duração base da sustentação, se isométrico
  execution      String[]         // passo a passo
  careNote       String           @db.Text

  // --- Sistema de progressão / variedade clínica ---
  anchor         Boolean          @default(false) // true = presente em toda sessão (proteção patelar/core)
  templateGroup  String?          // "A" (segunda) | "B" (quarta) | "C" (sexta)
  block          SessionBlock     @default(PRINCIPAL)
  pfjLoad        PfjLoad          @default(BAIXA)
  equipment      String[]         // vazio = peso do corpo
  rationale      String           @db.Text // por que este exercício está aqui, no caso dele
  phaseMin       Int              @default(1)     // fase (1/2/3) em que o exercício é liberado
  /// true = exercício que NÃO entra no plano automático porque depende de
  /// liberação explícita do fisioterapeuta. Fica visível numa seção separada,
  /// com o motivo, em vez de sumir do app.
  needsClearance Boolean          @default(false)
  clearanceNote  String?          @db.Text
  progression    Json             // { "1": {sets, reps, hold}, "2": {...}, "3": {...} }

  // --- Mídia externa (wger) ---
  // wgerExerciseId: id numérico estável do exercício na wger (resolução em 1 request).
  // wgerSearchTerm: nome EXATO em inglês na wger (o filtro ?name= é case-sensitive) —
  //                 usado só como fallback caso o id saia do ar.
  // Ambos null = nunca buscar mídia externa. Isso vale para:
  //   a) exercícios com amplitude restrita (mostrariam ROM completa = erro clínico);
  //   b) exercícios cuja única imagem disponível na wger ilustra outro movimento.
  wgerExerciseId Int?
  wgerSearchTerm String?

  logs WorkoutExerciseLog[]
  mediaCache ExerciseMediaCache?

  @@index([order])
}

// ---------------------------------------------------------------------------
// CACHE DE MÍDIA EXTERNA (wger.de) — evita bater na API a cada carregamento
// ---------------------------------------------------------------------------
model ExerciseMediaCache {
  id         String   @id @default(cuid())
  exerciseId String   @unique
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  found      Boolean  // false = já buscamos e não achamos match bom; não tenta de novo até expirar
  imageUrl   String?
  sourceName String?  // "wger.de"
  sourceUrl  String?  // página do exercício na wger (exigida pela atribuição da licença)
  license    String?  // nome curto REAL vindo da API (CC-BY-SA 4, CC-BY-SA 3, CC0...)
  author     String?  // license_author retornado pela API
  fetchedAt  DateTime @default(now())

  @@index([fetchedAt])
}

// ---------------------------------------------------------------------------
// SESSÕES DE TREINO / HISTÓRICO
// ---------------------------------------------------------------------------
model WorkoutLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  date       DateTime @default(now())
  // dayKey = "YYYY-MM-DD" no fuso do app (America/Sao_Paulo). Existe para garantir
  // UMA sessão por dia: duas sessões no mesmo dia corromperiam o cálculo de fase,
  // de streak e a alternância A/B (que conta sessões registradas).
  dayKey     String
  painLevel  Int      @default(0) // escala EVA 0-10
  swelling   Boolean  @default(false)
  notes      String?  @db.Text
  template   String?  // "A" | "B" — qual sessão foi executada
  phase      Int?     // fase clínica no momento da sessão (histórico auditável)

  exercises WorkoutExerciseLog[]

  @@unique([userId, dayKey])
  @@index([userId, date])
}

model WorkoutExerciseLog {
  id            String     @id @default(cuid())
  workoutLogId  String
  workoutLog    WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise   @relation(fields: [exerciseId], references: [id])
  setsCompleted Int?
  repsCompleted String?
  loadKg        Float?     // carga usada, quando aplicável (leg press, cadeira flexora...)
  painDuring    Int?       // dor específica durante o exercício (0-10)

  @@unique([workoutLogId, exerciseId])
}

// ---------------------------------------------------------------------------
// NUTRIÇÃO — alimentos estratégicos
// ---------------------------------------------------------------------------
enum FoodListType {
  ANTI_INFLAMATORIO
  SINERGIA_ALONG_C
  EVITAR
}

model FoodItem {
  id       String       @id @default(cuid())
  listType FoodListType
  nutrient String       // ex: "Ômega-3 (EPA/DHA)"
  sources  String       @db.Text
  note     String       @db.Text // frequência sugerida OU motivo de evitar
  order    Int          @default(0)

  // Chave natural: permite que o seed rode quantas vezes for preciso sem
  // duplicar a lista (antes, cada `npm run db:seed` triplicava a nutrição).
  @@unique([listType, nutrient])
}

// ---------------------------------------------------------------------------
// LISTA DE MERCADO (interativa, com checkbox persistido por usuário)
// ---------------------------------------------------------------------------
model ShoppingCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  isAvoidList Boolean  @default(false)
  order       Int      @default(0)

  items ShoppingItem[]
}

model ShoppingItem {
  id         String           @id @default(cuid())
  categoryId String
  category   ShoppingCategory @relation(fields: [categoryId], references: [id])
  name       String
  order      Int              @default(0)

  // checkbox é por usuário (cada um marca o que já comprou)
  userId  String?
  user    User?    @relation(fields: [userId], references: [id])
  checked Boolean  @default(false)

  // Chave natural para o seed ser idempotente PRESERVANDO o que já foi marcado.
  @@unique([categoryId, name])
}
